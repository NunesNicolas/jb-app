{
  "name": "jb-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "sync": "npm run build && cap sync",
    "android": "cap open android",
    "ios": "cap open ios",
    "test": "tsx --test tests/*.test.ts",
    "check:screens": "node scripts/check-screens.mjs",
    "test:e2e": "npm run build && node scripts/test-e2e.cjs"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/share": "^8.0.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.57.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@tailwindcss/vite": "^4",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4",
    "tsx": "^4",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
}
